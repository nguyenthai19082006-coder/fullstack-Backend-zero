<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/home.css" />
    <title>Create Users</title>
  </head>
  <body>
    <div class="topnav">
      <a href="/">Home</a>
      <a class="active" href="/create">Create Users</a>
    </div>

    <div class="form-add-new">
      <form action="/create-user" method="post">
        <fieldset>
          <legend>Add new users</legend>

          <div class="input-group">
            <label>Email: </label>
            <input type="text" id="emailID" name="myEmail" />
          </div>

          <div class="input-group">
            <label>Name: </label>
            <input type="text" name="myName" />
          </div>

          <div class="input-group">
            <label>City: </label>
            <input type="text" name="myCity" />
          </div>

          <div>
            <button>Save</button>
          </div>
        </fieldset>
      </form>
    </div>
  </body>
</html>
